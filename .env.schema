# Environment for the playground, loaded by varlock (https://varlock.dev).
#
# `pnpm dev` runs `next dev` through `varlock run`, and the Playwright e2e tests
# load this file in their main process (see playwright.config.ts): the dev
# server they start inherits the variables resolved here. `next build` and
# `next start` don't load it, they read the process environment, so a deploy
# never needs AWS access.
#
# The sandbox values are kept in a single AWS Systems Manager Parameter Store
# parameter, whose value is a JSON object keyed by variable name:
#
#   {
#     "CL_CLIENT_ID": "...",
#     "CL_MARKET_CODE": "...",
#     ...
#   }
#
# Each variable below that reads from it has an awsParam() value. Credentials
# come from the default AWS chain (AWS_PROFILE, SSO session, access keys, ...);
# the caller needs ssm:GetParameter on the parameter. AWS is only read with
# `LOAD_FROM_AWS=true`, so by default every value comes from `.env.local` or the
# process environment. They take precedence over this file also when AWS is on,
# and AWS is then only called for the variables they leave unset.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @generateTsTypes(path=tests/env.d.ts, importMetaEnv=none, processEnv=none)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-west-1)
# ---

# Set to `true` to read the sandbox values from AWS. Off by default: every
# variable then comes from `.env.local` or the process environment only.
# @type=boolean @internal
LOAD_FROM_AWS=false

# Parameter Store parameter holding the sandbox values.
# @internal
AWS_SSM_PARAMETER=/dev/payments-api-playground

# --- Required ---

# Sales channel application client ID (no secret needed).
# @required @sensitive
CL_CLIENT_ID=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_CLIENT_ID"))

# Market code, used as token scope (e.g. EU or US).
# @required
CL_MARKET_CODE=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_MARKET_CODE"))

# Your Commerce Layer organization domain (e.g. yourbrand.commercelayer.io).
# Defaults to the Commerce Layer domain.
# @optional
CL_DOMAIN=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_DOMAIN"))

# --- Store page ---

# SKU sold on the store page. Defaults to the first SKU with a price in the
# market.
# @optional
CL_SKU_CODE=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_SKU_CODE"))

# Country of the billing and shipping address given to the orders the store page
# creates. The rest of the address is a placeholder. Pick a country the market
# ships to, or the order gets no shipping method. Defaults to US.
# @optional
CL_ADDRESS_COUNTRY_CODE=

# Customer credentials for the Login/Logout demo button. The button is hidden
# when either is missing.
# @optional
CL_CUSTOMER_EMAIL=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_CUSTOMER_EMAIL"))

# @optional @sensitive
CL_CUSTOMER_PASSWORD=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_CUSTOMER_PASSWORD"))

# --- Integration application ---

# Integration application credentials. Server-side only. They back the express
# payment buttons (payment setting lookup), the Adyen advanced-flow card and
# saved-card payments on the checkout, the debug panels on the order page (gift
# cards, payment sessions) and the e2e tests. Without them the express buttons
# and the debug panels are hidden and Adyen advanced-flow payments fail.
# @optional @sensitive
CL_INTEGRATION_CLIENT_ID=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_INTEGRATION_CLIENT_ID"))

# @optional @sensitive
CL_INTEGRATION_CLIENT_SECRET=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_INTEGRATION_CLIENT_SECRET"))

# Set to 1 to show the debug panels on the order page (gift cards, payment
# sessions, placeable check) and enable the gift card actions behind them in a
# production build. They are always on in `next dev`. They act with the
# integration credentials on behalf of whoever opens the page, so leave them off
# on a public deploy.
# @optional
CL_DEBUG_PANELS=

# --- Adyen express (advanced flow) ---

# Apple Pay merchant for the Adyen express button (advanced flow) on the store
# page. The button is hidden when either is missing.
# @optional
CL_APPLE_PAY_MERCHANT_ID=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_APPLE_PAY_MERCHANT_ID"))

# @optional
CL_APPLE_PAY_MERCHANT_NAME=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="CL_APPLE_PAY_MERCHANT_NAME"))

# Apple Pay merchant country (ISO 3166). Must match the Apple Pay merchant
# registration in the Adyen Customer Area. Defaults to US.
# @optional
CL_EXPRESS_COUNTRY_CODE=

# --- External payment gateway (Mollie) ---
# Only needed when the organization has an external payment setting pointing at
# this app's /api/gateway/session, /api/gateway/authorize and
# /api/gateway/capture routes.

# Mollie API key used by the gateway routes to create and verify payments.
# @optional @sensitive
MOLLIE_API_KEY=

# Shared secret of the external payment setting. Used to verify the
# X-CommerceLayer-Signature header on incoming calls and to sign the
# notifications sent back to Commerce Layer. Without it the gateway routes
# refuse every call.
# @optional @sensitive
GATEWAY_SHARED_SECRET=

# Commerce Layer endpoint the Mollie webhook notifies when a payment changes
# status. Without it the notification is skipped.
# @optional
CL_WEBHOOK_ENDPOINT_URL=

# Public origin of this app (e.g. https://yourapp.example.com), used to build
# the Mollie return and webhook URLs. Defaults to the origin of the incoming
# request. Mollie must be able to reach the webhook, so on a local dev server
# set it to a public tunnel URL.
# @optional @type=url
APP_URL=

# --- Debugging ---

# Set to 1 to log every Commerce Layer API request with its exact body, on the
# server terminal and in the browser console. The body includes payment
# client_data, so keep it off by default.
# @optional
NEXT_PUBLIC_CL_DEBUG_REQUESTS=

# Hostname of a public tunnel (ngrok or similar) pointing at the dev server,
# without scheme or port — e.g. checkout.yourname.domain.dev. Next blocks
# /_next/* requests from any other origin, which leaves the page served but
# never hydrated.
# @optional
DEV_TUNNEL_HOST=

# --- E2E tests (Playwright) ---
# Only read by the tests in `tests/`, never by the app.

# Origin the tests visit. Defaults to http://localhost:3000; Adyen only accepts
# requests from localhost:3000 or :4000.
# @optional @type=url
E2E_BASE_URL=

# Set to 1 to skip the teardown that cancels the subscriptions and wallets the
# run created, e.g. to inspect a failed run.
# @optional
E2E_KEEP_DATA=

# PayPal sandbox buyer account, used by the PayPal specs to log in on PayPal's
# sandbox. Those specs are skipped when either is missing.
# @optional
E2E_PAYPAL_EMAIL=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_EMAIL"))

# @optional @sensitive
E2E_PAYPAL_PASSWORD=if($LOAD_FROM_AWS, awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_PASSWORD"))
