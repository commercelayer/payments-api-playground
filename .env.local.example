# ── Required ────────────────────────────────────────────────────────────────

# Sales channel application client ID (no secret needed)
CL_CLIENT_ID=

# Market code (used as token scope, e.g. EU or US)
CL_MARKET_CODE=

# Optional: your Commerce Layer organization domain
# e.g. yourbrand.commercelayer.io
CL_DOMAIN=

# ── Store page ──────────────────────────────────────────────────────────────

# Optional: SKU sold on the store page. Defaults to the first SKU with a price
# in the market.
CL_SKU_CODE=

# Optional: country of the billing and shipping address given to the orders the
# store page creates. The rest of the address is a placeholder. Pick a country
# the market ships to, or the order gets no shipping method. Defaults to US.
CL_ADDRESS_COUNTRY_CODE=

# Optional: customer credentials for the Login/Logout demo button. The button
# is hidden when either is missing.
CL_CUSTOMER_EMAIL=
CL_CUSTOMER_PASSWORD=

# ── Integration application ─────────────────────────────────────────────────

# Optional: integration application credentials. Server-side only. They back
# the express payment buttons (payment setting lookup), the Adyen advanced-flow
# card and saved-card payments on the checkout, the debug panels on the order
# page (gift cards, payment sessions) and the e2e tests. Without them the
# express buttons and the debug panels are hidden and Adyen advanced-flow
# payments fail.
CL_INTEGRATION_CLIENT_ID=
CL_INTEGRATION_CLIENT_SECRET=

# Optional: set to 1 to show the debug panels on the order page (gift cards,
# payment sessions, placeable check) and enable the gift card actions behind
# them in a production build. They are always on in `next dev`. They act with
# the integration credentials on behalf of whoever opens the page, so leave
# them off on a public deploy.
CL_DEBUG_PANELS=

# ── Adyen express (advanced flow) ───────────────────────────────────────────

# Optional: Apple Pay merchant for the Adyen express button (advanced flow) on
# the store page. The button is hidden when either is missing.
CL_APPLE_PAY_MERCHANT_ID=
CL_APPLE_PAY_MERCHANT_NAME=

# Optional: Apple Pay merchant country (ISO 3166). Must match the Apple Pay
# merchant registration in the Adyen Customer Area. Defaults to US.
CL_EXPRESS_COUNTRY_CODE=

# ── External payment gateway (Mollie) ───────────────────────────────────────
# Only needed when the organization has an external payment setting pointing
# at this app's /api/gateway/session, /api/gateway/authorize and
# /api/gateway/capture routes.

# Mollie API key used by the gateway routes to create and verify payments.
MOLLIE_API_KEY=

# Shared secret of the external payment setting. Used to verify the
# X-CommerceLayer-Signature header on incoming calls and to sign the
# notifications sent back to Commerce Layer. Required: without it the gateway
# routes refuse every call.
GATEWAY_SHARED_SECRET=

# Commerce Layer endpoint the Mollie webhook notifies when a payment changes
# status. Without it the notification is skipped.
CL_WEBHOOK_ENDPOINT_URL=

# Optional: public origin of this app (e.g. https://yourapp.example.com), used
# to build the Mollie return and webhook URLs. Defaults to the origin of the
# incoming request. Mollie must be able to reach the webhook, so on a local dev
# server set it to a public tunnel URL.
APP_URL=

# ── Debugging ───────────────────────────────────────────────────────────────

# Optional: set to 1 to log every Commerce Layer API request with its exact
# body, on the server terminal and in the browser console. The body includes
# payment client_data, so keep it off by default.
NEXT_PUBLIC_CL_DEBUG_REQUESTS=

# Optional: hostname of a public tunnel (ngrok or similar) pointing at the dev
# server, without scheme or port — e.g. checkout.yourname.domain.dev.
# Next blocks /_next/* requests from any other origin, which leaves the page
# served but never hydrated.
DEV_TUNNEL_HOST=

# ── E2E tests ───────────────────────────────────────────────────────────────
# Read by the Playwright suite only, never by the app.

# Optional: PayPal sandbox buyer account, used by the Adyen Drop-in PayPal spec
# to log in on PayPal's sandbox. The spec is skipped when either is missing.
E2E_PAYPAL_EMAIL=
E2E_PAYPAL_PASSWORD=
