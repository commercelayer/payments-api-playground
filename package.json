{
  "name": "@commercelayer/payments-api-playground",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "varlock run -- next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "pnpm biome check --write",
    "clean": "pnpm dlx rimraf --glob **/node_modules **/pnpm-lock.yaml",
    "dep:major": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u",
    "dep:semver": "pnpm dlx npm-check-updates -t semver --packageFile '**/package.json' -u",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.47.0",
    "@checkout.com/checkout-web-components": "^1.14.0",
    "@commercelayer/js-auth": "^8.0.2",
    "@commercelayer/sdk": "^8.0.3",
    "@mollie/api-client": "^4.6.0",
    "@paypal/paypal-js": "^11.3.0",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "braintree-web": "^3.147.0",
    "braintree-web-drop-in": "^1.48.0",
    "next": "^16.4.3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/braintree-web": "^3.143.2",
    "@types/braintree-web-drop-in": "^1.39.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@varlock/aws-secrets-plugin": "^1.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "varlock": "^1.23.0"
  }
}
